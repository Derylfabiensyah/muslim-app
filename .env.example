# Environment Variables Template for Muslim App
# Copy file ini menjadi .env dan isi dengan API key Anda

# Gemini AI API Key
# Dapatkan di: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API Endpoints (jika diperlukan)
# QURAN_API_URL=https://api.example.com
# SHALAT_API_URL=https://api.example.com
